CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_NN_OPTIMIZED=y
# per-task run-time stats, used to measure real CPU load per core
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# PSRAM deliberately NOT enabled: everything must fit in internal SRAM

# ---- Step 5c: networking kept off the detection core, and a leaner RAM footprint
# lwIP's TCP/IP task on core 0 (it was running on core 1 during streaming: 12-13% CPU)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Wi-Fi and lwIP code run from flash instead of internal RAM (plenty fast for 71 kbit/s)
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# fewer Wi-Fi buffers (defaults 10 / 32 / 32 are sized for Mbit/s throughput)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
# the app had only 8% of its 1 MB partition left
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- Step 5d: more code out of RAM (measured with esp_idf_size --archives)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# SPI-flash driver from the chip's ROM instead of RAM (~10 KB). If flash or
# NVS ever misbehaves, delete this line and run idf.py set-target esp32s3.
CONFIG_SPI_FLASH_ROM_IMPL=y

# ---- Step 5f: bound the heap when the network stalls (measured peak 129 KB
# during a Wi-Fi hiccup vs 113 KB normally). 2 x MSS is plenty for 71 kbit/s.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
